{
  "name": "lj-reborn",
  "private": true,
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "husky",
    "dev:back": "pnpm --filter @lj/backend dev",
    "dev:front": "pnpm --filter @lj/frontend dev",
    "test:back": "pnpm --filter @lj/backend test",
    "test:front": "pnpm --filter @lj/frontend test",
    "test:e2e": "pnpm --filter @lj/e2e test",
    "test:shared": "pnpm --filter @lj/e2e test"
  },
  "keywords": [],
  "author": "Viseko23 <viseko23@gmail.com>",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.scss": [
      "pnpm --filter @lj/frontend exec stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
