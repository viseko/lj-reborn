{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "mentor",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(docs/ROADMAP.md)",
      "Write(docs/ROADMAP.md)",
      "Edit(docs/cheatsheets/**)",
      "Write(docs/cheatsheets/**)",
      "Edit(docs/learning/**)",
      "Write(docs/learning/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:check:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec stylelint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm --filter * exec tsc:*)",
      "Bash(pnpm --filter * test:*)",
      "Bash(pnpm --filter * exec vitest:*)",
      "Bash(pnpm -r test:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm lint:fix:*)",
      "Bash(pnpm exec eslint --fix:*)",
      "Bash(pnpm exec stylelint --fix:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(pnpm prisma migrate:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-writes.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\""
          }
        ]
      }
    ]
  }
}
